# PostgreSQL / Neon. Use the pooled connection for the application.
DATABASE_URL=
# Optional local Docker database, generated by npm run db:local:setup.
LOCAL_POSTGRES_PASSWORD=
# Use a direct connection for migrations, when required by your provider.
DIRECT_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Parent sign-in: only explicitly allowed, verified Google email addresses may sign in.
PARENT_EMAILS=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Separate child Classroom OAuth. Register this callback in the Google web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Browser collection is the default. Set api to restore the retained OAuth integration.
CLASSROOM_SOURCE=browser
SCHOOL_SYNC_MODE=local
# Server-only cloud login settings. Set SCHOOL_SYNC_MODE=cloud on Vercel.
CLASSROOM_E_USERNAME=
CLASSROOM_E_PASSWORD=
CLASSROOM_A_USERNAME=
CLASSROOM_A_PASSWORD=
# Optional separate machine key for cloud-refresh verification; never an extension key.
SCHOOL_SYNC_KEY=
# Separate random token (at least 32 characters) for the Chrome extension's import endpoint.
# This grants write access for both children; never put it in NEXT_PUBLIC_ variables.
KIDS_DASHBOARD_INGEST_KEY=
GENESIS_USERNAME=
GENESIS_PASSWORD=
GENESIS_STUDENT_E=
GENESIS_STUDENT_A=
# 32 random bytes, base64 encoded. Preserve this key to keep stored tokens usable.
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Local development only. Production always rejects demo authentication/data.
DEMO_MODE=false
