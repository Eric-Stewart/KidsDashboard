{
  "name": "family-school-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "collector:setup": "node scripts/setup-collector.mjs",
    "collector:check": "tsx collector/run.ts --check",
    "collector:run": "tsx collector/run.ts",
    "extension:build": "node classroom-extension/build.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && node scripts/build-cloud-collector.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:local:setup": "node scripts/setup-local-db.mjs",
    "db:local:start": "docker compose --env-file .env.local up -d --wait",
    "db:local:stop": "docker compose --env-file .env.local stop",
    "db:local:status": "docker compose --env-file .env.local ps"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sparticuz/chromium": "^153.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.16.0",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
